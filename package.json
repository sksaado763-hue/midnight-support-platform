{
  "name": "midnight-support-platform",
  "version": "2.0.0",
  "description": "MERN rebuild of a 24/7 support and managed cloud agency site — MongoDB-backed Express API, React (Vite) front end, working forms and an admin inbox.",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "seed": "npm run seed --workspace server",
    "db:start": "docker run -d --name midnight-mongo -p 27017:27017 -v midnight_mongo:/data/db mongo:7"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
