{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/articles",
      "has": [
        {
          "type": "query",
          "key": "tag",
          "value": "Employee Spotlight"
        }
      ],
      "destination": "/api/articles/by-tag/employee-spotlight.json"
    },
    {
      "source": "/api/articles",
      "has": [
        {
          "type": "query",
          "key": "tag",
          "value": "Incident Management"
        }
