<%- include("../partials/head", { title }) %>
<%- include("../partials/header", { navActive }) %>

    <section class="page-hero">
      <div class="container">
        <h1 class="page-hero-title reveal">Contact Us</h1>
        <p class="page-hero-sub reveal">Whether it's a 3am incident, a migration plan or a quick question — we're around. Messages land straight in our (working, actually-used) inbox.</p>
      </div>
    </section>

    <section class="contact-section">
      <div class="container contact-grid">
        <div class="contact-info reveal">
          <h2>Direct lines</h2>
          <ul class="contact-list">
            <li>
              <span class="contact-label">Email us</span>
              <a href="mailto:hello@example.test">hello@example.test</a>
            </li>
            <li>
              <span class="contact-label">Call us (24/7)</span>
              <a href="tel:+442030000247">+44 20 3000 0247</a>
            </li>
            <li>
              <span class="contact-label">Existing client, live incident?</span>
              <a href="tel:+442030000247">Use the emergency line — it pages a human</a>
            </li>
          </ul>
          <h2>Office</h2>
          <p class="contact-address">
            Unit 12, The Old Printworks<br>
            128 Nightingale Road<br>
            London, UK
          </p>
          <div class="contact-map" aria-hidden="true">
            <svg viewBox="0 0 400 220">
              <rect width="400" height="220" fill="#1E3E55"/>
              <g stroke="#3E5C78" stroke-width="8" stroke-linecap="round">
                <path d="M0 60h400M0 150h400M90 0v220M260 0v220"/>
              </g>
              <g stroke="#1E3E55" stroke-width="5" stroke-linecap="round">
                <path d="M0 60h400M0 150h400M90 0v220M260 0v220"/>
              </g>
              <path d="M-10 200 L180 60" stroke="#00A6B8" stroke-width="7" stroke-linecap="round"/>
              <circle cx="175" cy="105" r="20" fill="#00E8F0"/>
              <path d="M175 87a9 9 0 0 1 9 9c0 6-9 17-9 17s-9-11-9-17a9 9 0 0 1 9-9z" fill="#3E5C78"/>
              <circle cx="175" cy="96" r="3.4" fill="#00E8F0"/>
            </svg>
          </div>
        </div>

        <form class="contact-form reveal" id="contact-form" data-endpoint="/api/contact" novalidate>
          <h2>Send us a message</h2>
          <div class="form-row form-row--split">
            <div>
              <label for="ct-name">Name <span aria-hidden="true">*</span></label>
              <input type="text" id="ct-name" name="name" required autocomplete="name">
            </div>
            <div>
              <label for="ct-company">Company</label>
              <input type="text" id="ct-company" name="company" autocomplete="organization">
            </div>
          </div>
          <div class="form-row">
            <label for="ct-email">Email <span aria-hidden="true">*</span></label>
            <input type="email" id="ct-email" name="email" required autocomplete="email">
          </div>
          <div class="form-row">
            <label for="ct-topic">What's this about?</label>
            <select id="ct-topic" name="topic">
              <option value="support">24/7 Support packages</option>
              <option value="cloud">Managed Cloud &amp; DevOps</option>
              <option value="partnership">Partnerships</option>
              <option value="careers">Careers</option>
              <option value="other">Something else</option>
            </select>
          </div>
          <div class="form-row">
            <label for="ct-message">Message <span aria-hidden="true">*</span></label>
            <textarea id="ct-message" name="message" rows="5" required placeholder="Tell us what you're running, what hurts, and when it hurts most."></textarea>
          </div>
          <button type="submit" class="btn btn-primary">Send message <span aria-hidden="true">➔</span></button>
          <p class="form-status" id="contact-form-status" role="status"></p>
        </form>
      </div>
    </section>

<%- include("../partials/latest-insights") %>
<%- include("../partials/foot", { year }) %>
