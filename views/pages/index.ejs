<%- include("../partials/head", { title }) %>
<%- include("../partials/header", { navActive }) %>

    <!-- HERO -->
    <section class="homepage-hero">
      <div class="hero-stars" aria-hidden="true">
        <svg viewBox="0 0 1440 520" preserveAspectRatio="xMidYMid slice">
          <g fill="#ffffff">
            <circle cx="120" cy="80" r="1.6" opacity=".7"/><circle cx="300" cy="180" r="1.2" opacity=".5"/>
            <circle cx="520" cy="60" r="1.8" opacity=".8"/><circle cx="760" cy="140" r="1.1" opacity=".4"/>
            <circle cx="980" cy="70" r="1.5" opacity=".7"/><circle cx="1180" cy="190" r="1.3" opacity=".6"/>
            <circle cx="1340" cy="90" r="1.7" opacity=".8"/><circle cx="200" cy="320" r="1.2" opacity=".4"/>
            <circle cx="640" cy="300" r="1.4" opacity=".6"/><circle cx="1080" cy="330" r="1.2" opacity=".5"/>
            <circle cx="1380" cy="300" r="1.5" opacity=".7"/><circle cx="440" cy="200" r="1" opacity=".4"/>
          </g>
        </svg>
      </div>
      <div class="container hero-inner">
        <h1 class="hero-title reveal">24/7 support, cloud &amp; DevOps for brands, agencies and digital products</h1>
        <p class="hero-subtitle reveal">Keeping your revenue, reputation and digital estate protected — every hour, every day of the year.</p>
        <div class="hero-actions reveal">
          <a href="/support" class="btn btn-primary">View support packages <span aria-hidden="true">➔</span></a>
          <a href="/contact" class="btn btn-outline">Speak to us <span aria-hidden="true">➔</span></a>
        </div>
        <div class="hero-trust reveal">
          <p class="trust-label">Trusted by:</p>
          <ul class="trust-logos" aria-label="Selected clients">
            <li class="trust-logo">TESSERA</li>
            <li class="trust-logo">HELIOS&nbsp;BANK</li>
            <li class="trust-logo">NORTHBANK</li>
            <li class="trust-logo">ARCADIA</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- STATS STRIP -->
    <section class="stats-strip" aria-label="Key numbers">
      <div class="container stats-grid">
        <% stats.forEach(function (s) { %>
          <div class="stat reveal">
            <p class="stat-value"><%= s.value %></p>
            <p class="stat-label"><%= s.label %></p>
          </div>
        <% }) %>
      </div>
    </section>

    <!-- SERVICES -->
    <section class="full-services" id="services">
      <div class="container">
        <h2 class="section-title reveal">Our Services</h2>
        <div class="services-grid">

          <article class="service-card reveal">
            <div class="service-icon" aria-hidden="true">
              <svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="19" fill="none" stroke="currentColor" stroke-width="2.4"/><path d="M24 13v11l7 5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
            </div>
            <h3>24/7 Support</h3>
            <p>Full-stack monitoring, triage and resolution — every hour of every day, all year round.</p>
            <ul class="service-links">
              <li><a href="/support">Support Packages</a></li>
              <li><a href="/support#industries">By Industry <span aria-hidden="true">·</span> Agencies · SaaS · eCommerce</a></li>
              <li><a href="/cloud">By Cloud Provider <span aria-hidden="true">·</span> AWS · Azure · GCP</a></li>
            </ul>
          </article>

          <article class="service-card reveal">
            <div class="service-icon" aria-hidden="true">
              <svg viewBox="0 0 48 48"><path d="M14 30a8 8 0 0 1 .6-15.9A10 10 0 0 1 34 17a7 7 0 0 1-1 13H14z" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/><path d="M17 37l4-5m5 5l-3-4" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
            </div>
            <h3>Managed Cloud</h3>
            <p>Consulting, architecture and delivery across AWS, Azure and Google Cloud.</p>
            <ul class="service-links">
              <li><a href="/cloud#aws">AWS · Azure · GCP · Alibaba Cloud</a></li>
              <li><a href="/cloud#consulting">Cloud Consulting &amp; Cost Optimisation</a></li>
              <li><a href="/cloud#consulting">Cloud Migration &amp; Managed Hosting</a></li>
            </ul>
          </article>

          <article class="service-card reveal">
            <div class="service-icon" aria-hidden="true">
              <svg viewBox="0 0 48 48"><path d="M8 34l6-6 6 4 7-10 6 6 7-12" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/><circle cx="40" cy="12" r="3" fill="currentColor"/></svg>
            </div>
            <h3>DevOps</h3>
            <p>Helping teams ship faster without trading away reliability or quality.</p>
            <ul class="service-links">
              <li><a href="/cloud#devops">DevOps Delivery &amp; Automation</a></li>
              <li><a href="/cloud#devops">DevOps Consulting</a></li>
              <li><a href="/cloud#devops">Application Modernisation</a></li>
            </ul>
          </article>

          <article class="service-card reveal">
            <div class="service-icon" aria-hidden="true">
              <svg viewBox="0 0 48 48"><rect x="7" y="9" width="34" height="24" rx="3" fill="none" stroke="currentColor" stroke-width="2.4"/><path d="M17 41h14M24 33v8" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/><path d="M16 20l5 4-5 4M25 28h7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>
            </div>
            <h3>Platform Support</h3>
            <p>Care and maintenance for SaaS products, CMS platforms and custom applications.</p>
            <ul class="service-links">
              <li><a href="/support#industries">SaaS Application Support</a></li>
              <li><a href="/support#industries">Custom Applications</a></li>
              <li><a href="/platforms">Platforms <span aria-hidden="true">·</span> Sitecore · Umbraco · WordPress</a></li>
            </ul>
          </article>

        </div>
      </div>
    </section>

    <!-- STATEMENT -->
    <section class="statement" id="statement">
      <div class="container statement-inner">
        <svg class="statement-arrow" viewBox="0 0 64 64" aria-hidden="true">
          <path d="M32 56V14M16 30l16-16 16 16" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <h2 class="statement-title reveal">We're the experts in uptime.</h2>
        <p class="statement-text reveal">We build, run and look after your infrastructure, applications and services through a world-class 24/7 support operation — and we step in fast when things go wrong, so your team can sleep at night.</p>
      </div>
    </section>

    <!-- PARTNERS & CLIENTS -->
    <section class="partners-and-clients">
      <div class="container">
        <h2 class="section-title reveal">A few of our partners &amp; clients</h2>

        <div class="tabs reveal" role="tablist" aria-label="Client types">
          <button class="tab is-active" role="tab" aria-selected="true" data-tab="brands">Brands</button>
          <button class="tab" role="tab" aria-selected="false" data-tab="technology">Technology</button>
          <button class="tab" role="tab" aria-selected="false" data-tab="agencies">Agencies</button>
        </div>

        <div class="tab-panel is-active" data-panel="brands">
          <ul class="logo-grid">
            <li class="logo-cell">TESSERA</li><li class="logo-cell">NORTHBANK</li>
            <li class="logo-cell">ARCADIA</li><li class="logo-cell">VOLTA</li>
            <li class="logo-cell">MERIDIAN</li><li class="logo-cell">HALCYON</li>
            <li class="logo-cell">ORCHARD&amp;CO</li><li class="logo-cell">BLUEPINE</li>
          </ul>
        </div>
        <div class="tab-panel" data-panel="technology" hidden>
          <ul class="logo-grid">
            <li class="logo-cell">CLOUDVEIL</li><li class="logo-cell">STACKFORGE</li>
            <li class="logo-cell">QUANTA</li><li class="logo-cell">NIMBUS9</li>
            <li class="logo-cell">COREWIRE</li><li class="logo-cell">BYTEHARBOR</li>
            <li class="logo-cell">LATTICE</li><li class="logo-cell">SIGNALWORKS</li>
          </ul>
        </div>
        <div class="tab-panel" data-panel="agencies" hidden>
          <ul class="logo-grid">
            <li class="logo-cell">PIXEL&amp;MORE</li><li class="logo-cell">STUDIO NORTH</li>
            <li class="logo-cell">FRAMECRAFT</li><li class="logo-cell">THE ATELIER</li>
            <li class="logo-cell">MOSAIC CO</li><li class="logo-cell">BOLDTYPE</li>
            <li class="logo-cell">FIELDNOTES</li><li class="logo-cell">HARLOW</li>
          </ul>
        </div>

        <div class="partners-cta reveal">
          <a href="/contact" class="btn btn-primary">Find out more about partnerships <span aria-hidden="true">➔</span></a>
          <svg class="partners-illustration" viewBox="0 0 220 200" aria-hidden="true">
            <circle cx="120" cy="110" r="62" fill="#123044"/>
            <circle cx="120" cy="110" r="62" fill="none" stroke="#00A6B8" stroke-width="2" opacity=".5"/>
            <path d="M120 48a62 62 0 0 1 0 124 78 78 0 0 0 0-124z" fill="#00E8F0"/>
            <circle cx="150" cy="78" r="5" fill="#B6F5FA"/>
            <line x1="150" y1="73" x2="150" y2="58" stroke="#B6F5FA" stroke-width="2.5" stroke-linecap="round"/>
            <circle cx="150" cy="55" r="3.5" fill="#B6F5FA"/>
            <circle cx="42" cy="46" r="2" fill="#ffffff" opacity=".7"/>
            <circle cx="196" cy="160" r="2.4" fill="#ffffff" opacity=".6"/>
            <circle cx="60" cy="170" r="1.8" fill="#ffffff" opacity=".5"/>
          </svg>
        </div>
      </div>
    </section>

    <!-- CASE STUDIES TEASER -->
    <section class="cases-teaser">
      <div class="container">
        <div class="insights-head reveal">
          <h2 class="section-title">Proof, not promises</h2>
          <a href="/case-studies" class="text-link">All case studies <span aria-hidden="true">➔</span></a>
        </div>
        <div class="case-teaser-grid">
          <a class="case-teaser reveal" href="/case-studies">
            <div class="case-teaser-art case-teaser-art--a" aria-hidden="true">
              <svg viewBox="0 0 200 90"><path d="M30 74h140" stroke="#6E8FAD" stroke-width="4" stroke-linecap="round"/><path d="M44 74V48l24-16 24 14 24-24v52" fill="none" stroke="#00E8F0" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
            <p class="case-teaser-copy"><strong>40+ platforms</strong> kept online through peak campaigns, payroll windows and 3am surprises. See how.</p>
          </a>
        </div>
      </div>
    </section>

    <!-- REPORT DOWNLOAD CTA -->
    <section class="report-download-cta">
      <div class="container">
        <div class="report-card reveal">
          <div class="report-art" aria-hidden="true">
            <svg viewBox="0 0 200 160">
              <path d="M40 132h120" stroke="#6E8FAD" stroke-width="4" stroke-linecap="round"/>
              <path d="M52 132V84l32-24 32 20 32-36v88" fill="none" stroke="#00E8F0" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="116" cy="44" r="6" fill="#00A6B8"/>
              <rect x="146" y="52" width="10" height="80" rx="4" fill="#123044" transform="rotate(18 151 92)"/>
            </svg>
          </div>
          <div class="report-copy">
            <h2>What does a "perfect" AWS setup look like for SaaS?</h2>
            <p>Perfection may not exist — but seeing how experts approach it is the next best thing. Four frontline perspectives on hyperscale, developer-first architecture, and balancing next-gen tech with what's proven and comfy.</p>
            <a href="/contact" class="btn btn-primary">Download the report <span aria-hidden="true">➔</span></a>
          </div>
        </div>
      </div>
    </section>

<%- include("../partials/latest-insights") %>

<%- include("../partials/foot", { year }) %>
