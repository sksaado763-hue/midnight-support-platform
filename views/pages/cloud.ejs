<%- include("../partials/head", { title }) %>
<%- include("../partials/header", { navActive }) %>

    <section class="page-hero">
      <div class="container">
        <h1 class="page-hero-title reveal">Managed Cloud &amp; DevOps</h1>
        <p class="page-hero-sub reveal">Next-gen cloud and DevOps services that scale with you — from ambitious start-up to global enterprise. We design, build, migrate and run infrastructure on the platforms you already trust.</p>
      </div>
    </section>

    <section class="cloud-section">
      <div class="container">
        <h2 class="section-title reveal">Cloud providers we work across</h2>
        <div class="provider-grid">
          <article class="provider-card reveal" id="aws">
            <div class="provider-badge" aria-hidden="true"><strong>aws</strong></div>
            <h3>Amazon Web Services</h3>
            <p>Our deepest specialism — from Well-Architected Reviews to landing zones, ECS/EKS operations and cost programmes that routinely claw back double-digit percentages of spend.</p>
            <ul class="service-links">
              <li><a href="#">Well-Architected Reviews</a></li>
              <li><a href="#">EKS &amp; container platforms</a></li>
              <li><a href="#">Reserved capacity strategy</a></li>
            </ul>
          </article>
          <article class="provider-card reveal" id="azure">
            <div class="provider-badge provider-badge--azure" aria-hidden="true"><strong>A</strong></div>
            <h3>Microsoft Azure</h3>
            <p>Enterprise-grade Azure design and operations: AKS, App Service estates, hybrid connectivity and the governance guardrails that keep a growing subscription estate tidy.</p>
            <ul class="service-links">
              <li><a href="#">AKS operations &amp; upgrades</a></li>
              <li><a href="#">Landing zones &amp; policy as code</a></li>
              <li><a href="#">Hybrid connectivity</a></li>
            </ul>
          </article>
          <article class="provider-card reveal" id="gcp">
            <div class="provider-badge provider-badge--gcp" aria-hidden="true"><strong>G</strong></div>
            <h3>Google Cloud Platform</h3>
            <p>Data-heavy workloads, GKE fleets and the networking clarity that GCP rewards when it's done right. We run production GCP estates for SaaS and analytics teams.</p>
            <ul class="service-links">
              <li><a href="#">GKE fleet management</a></li>
              <li><a href="#">BigQuery &amp; data pipelines</a></li>
              <li><a href="#">Cloud Run &amp; serverless</a></li>
            </ul>
          </article>
        </div>
      </div>
    </section>

    <section class="cloud-section cloud-section--alt" id="consulting">
      <div class="container">
        <h2 class="section-title reveal">Cloud consulting</h2>
        <div class="consult-grid">
          <article class="consult-card reveal">
            <h3>Cost Optimisation</h3>
            <p>A forensic review of your estate that typically finds 20–40% of spend with no good reason to exist. We fix the causes, not just the symptoms.</p>
          </article>
          <article class="consult-card reveal">
            <h3>Well-Architected Review</h3>
            <p>A structured health check against the pillars that matter — operational excellence, security, reliability, performance and cost — with a prioritised remediation plan.</p>
          </article>
          <article class="consult-card reveal">
            <h3>Solution Architecture</h3>
            <p>Designs for the tricky bits: multi-region failover, compliance-ready environments, event-driven architectures that stay debuggable at scale.</p>
          </article>
          <article class="consult-card reveal">
            <h3>Cloud Migration</h3>
            <p>Wave-based migrations with rollback paths at every step. We've moved platforms with zero customer-visible downtime — and we can prove it.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="cloud-section" id="devops">
      <div class="container">
        <h2 class="section-title reveal">DevOps services</h2>
        <div class="devops-feature reveal">
          <div>
            <h3>Delivery &amp; Automation</h3>
            <p>Pipelines that teams actually trust: fast, boring, reversible. Progressive delivery, automated rollback, environment parity, and test gates that catch the right things. When deploys stop being scary, teams ship more — and sleep better.</p>
            <a href="/contact" class="btn btn-primary">Talk DevOps <span aria-hidden="true">➔</span></a>
          </div>
          <div class="pipeline-art" aria-hidden="true">
            <svg viewBox="0 0 360 220">
              <g font-family="Space Grotesk, sans-serif" font-size="12" font-weight="700">
                <rect x="10" y="20" width="88" height="34" rx="17" fill="#3E5C78"/>
                <text x="54" y="41" fill="#fff" text-anchor="middle">commit</text>
                <rect x="122" y="20" width="88" height="34" rx="17" fill="#1E3E55"/>
                <text x="166" y="41" fill="#fff" text-anchor="middle">build</text>
                <rect x="234" y="20" width="88" height="34" rx="17" fill="#00A6B8"/>
                <text x="278" y="41" fill="#fff" text-anchor="middle">test</text>
                <rect x="122" y="100" width="88" height="34" rx="17" fill="#123044"/>
                <text x="166" y="121" fill="#fff" text-anchor="middle">staging</text>
                <rect x="234" y="100" width="88" height="34" rx="17" fill="#00E8F0"/>
                <text x="278" y="121" fill="#04222A" text-anchor="middle">deploy</text>
              </g>
              <g stroke="#00E8F0" stroke-width="2.5" fill="none" stroke-linecap="round">
                <path d="M98 37h16"/>
                <path d="M210 37h16"/>
                <path d="M278 54v22c0 12-10 20-22 20h-58"/>
                <path d="M210 117h16"/>
                <path d="M166 54v30c0 10 8 16 18 16h-14"/>
              </g>
              <g fill="#B6F5FA">
                <circle cx="166" cy="160" r="4"/>
                <circle cx="278" cy="160" r="4"/>
              </g>
              <text x="166" y="184" fill="#9BB4CC" font-size="11" font-family="Inter, sans-serif" text-anchor="middle">rollback in 60s</text>
              <text x="278" y="184" fill="#9BB4CC" font-size="11" font-family="Inter, sans-serif" text-anchor="middle">canary + auto-halt</text>
            </svg>
          </div>
        </div>
        <div class="consult-grid">
          <article class="consult-card reveal">
            <h3>DevOps Consulting</h3>
            <p>Embedded coaching for teams who want to own their pipeline, not rent one. We work in your repo, with your engineers, until good practices are just how things are done.</p>
          </article>
          <article class="consult-card reveal">
            <h3>Application Modernisation</h3>
            <p>Containerisation, decomposition and cloud-native rewrites — sequenced so the business keeps running while the foundations improve underneath it.</p>
          </article>
        </div>
      </div>
    </section>

