<%- include("../partials/head", { title }) %>
<%- include("../partials/header", { navActive }) %>

    <section class="page-hero">
      <div class="container">
        <h1 class="page-hero-title reveal">Platforms We Support</h1>
        <p class="page-hero-sub reveal">Managed support services for all major platforms. 24/7 full-stack support; uptime guaranteed.</p>
        <div class="hero-actions reveal">
          <a href="/contact" class="btn btn-primary">Speak to us about your platform <span aria-hidden="true">➔</span></a>
        </div>
      </div>
    </section>

    <section class="platforms-list">
      <div class="container">
        <div class="platform-grid">
          <% allPlatforms.forEach(function (p) { %>
            <article class="platform-card reveal">
              <div class="platform-badge platform-badge--<%= p.tint %>" aria-hidden="true"><%= p.short %></div>
              <h2><%= p.name %></h2>
              <p><%= p.intro %></p>
              <a class="text-link" href="/platforms/<%= p.slug %>">Explore <%= p.name %> support <span aria-hidden="true">➔</span></a>
            </article>
          <% }) %>
        </div>
      </div>
    </section>

    <section class="statement">
      <div class="container statement-inner">
        <h2 class="statement-title reveal">Running something else entirely?</h2>
        <p class="statement-text reveal">If it runs software, we've probably supported something like it. Tell us what you're running and we'll tell you honestly whether we can help.</p>
        <div class="hero-actions reveal" style="justify-content:center">
          <a href="/contact" class="btn btn-primary">Ask about your stack <span aria-hidden="true">➔</span></a>
        </div>
      </div>
    </section>

<%- include("../partials/latest-insights") %>
<%- include("../partials/foot", { year }) %>
