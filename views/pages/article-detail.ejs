<%- include("../partials/head", { title }) %>
<%- include("../partials/header", { navActive }) %>

    <section class="page-hero">
      <div class="container">
        <p class="breadcrumb"><a href="/insights">Insights</a> <span aria-hidden="true">/</span> <%= article.tag %></p>
        <h1 class="page-hero-title reveal"><%= article.title %></h1>
        <p class="article-meta reveal">
          <span class="tag <%= article.tagClass %>"><%= article.tag %></span>
          <time datetime="<%= article.date %>"><%= article.dateLabel %></time>
          <span>· 4 min read</span>
        </p>
      </div>
    </section>

    <section class="article-body-section">
      <div class="container article-wrap">
        <article class="prose reveal">
          <% article.body.forEach(function (para) { %>
            <p><%= para %></p>
          <% }) %>
        </article>

        <nav class="article-nav reveal" aria-label="More articles">
          <% if (prev) { %>
            <a class="article-nav-link" href="/insights/<%= prev.slug %>">
              <span class="article-nav-dir">← Previous</span>
              <span class="article-nav-title"><%= prev.title %></span>
            </a>
          <% } else { %>
            <span></span>
          <% } %>
          <% if (next) { %>
            <a class="article-nav-link article-nav-link--next" href="/insights/<%= next.slug %>">
              <span class="article-nav-dir">Next →</span>
              <span class="article-nav-title"><%= next.title %></span>
            </a>
          <% } %>
        </nav>
      </div>
    </section>

<%- include("../partials/latest-insights") %>
<%- include("../partials/foot", { year }) %>
